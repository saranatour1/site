{
	"name": "site",
	"compatibility_date": "2026-06-12",
	"main": "./worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Without this, static hits skip the worker and never get tracked.
		"run_worker_first": true
	},
	// Required by `wrangler preview` (PR preview deploys). Empty: previews use the same settings as production.
	"previews": {},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		// The dashboard calls this "issue_detection"; wrangler's key is "issues".
		"issues": {
			"enabled": true
		}
	}
}
