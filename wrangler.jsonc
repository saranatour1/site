{
	"name": "site",
	"compatibility_date": "2026-06-12",
	"main": "./worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Without this, static hits skip the worker and never get tracked.
		"run_worker_first": true
	},
	"vars": {
		// Public: same ID as data-client-id in BaseHead.astro.
		"DATABUDDY_WEBSITE_ID": "620a95f1-a26a-46ed-85c2-ca015f7fde75"
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		// The dashboard calls this "issue_detection"; wrangler's key is "issues".
		"issues": {
			"enabled": true
		}
	}
}
