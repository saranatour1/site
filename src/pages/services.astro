---
import Layout from "../layouts/Layout.astro";
import Mail from "../components/Icons/Mail.astro";
import { socialLinks } from "../consts";

const email = socialLinks.find((r) => r["label"]==="email");
---

<Layout title="Services" description="Services offered by Sara Natour">
  <main class="w-full max-w-200 mx-auto flex flex-col gap-4">
    <header class="flex flex-col items-center gap-4 rounded-2xl border border-blue-1 px-10 py-16 text-center max-sm:px-5 max-sm:py-12">
      <p class="text-sm text-[#6b6860]">Latest update: Aug 16</p>
      <h1 class="text-7xl leading-none tracking-tight max-sm:text-5xl">What I do</h1>
      <p class="max-w-150 text-lg leading-relaxed text-[#4a4843]">
        I'm a software developer working remotely with clients and startups to shape up their software. I do testing, frontend, and backend development. I mostly work with <a href="https://www.convex.dev" target="_blank" rel="noopener noreferrer" class="text-blue-1 underline underline-offset-4">Convex</a>, but it's not my main thing of expertise. I also have strong experience in building and integrating AI Agents into products.
      </p>
    </header>

    <section aria-labelledby="looking-for" class="flex flex-col gap-3 rounded-2xl border border-blue-1 p-10 max-sm:px-5">
      <h2 id="looking-for" class="text-2xl">Looking for</h2>
      <p class="leading-relaxed text-[#4a4843]">I am actively looking for new projects, open to relocating, and open to new well-developed opportunities.</p>
    </section>

    <section aria-labelledby="interests" class="flex flex-col gap-3 rounded-2xl border border-blue-1 p-10 max-sm:px-5">
      <h2 id="interests" class="text-2xl">Other interests &amp; hobbies</h2>
      <p class="leading-relaxed text-[#4a4843]">
        I am an Electrical Engineering graduate, and I work on making electronics designs with Arduino, ESPs, microcontrollers, and write and design the code for you. I have experience in Eagle, Flux, and other design apps.
      </p>
      <p class="leading-relaxed text-[#4a4843]">I also do wood designs as a hobby, a beginner gardner. My favorite companies are Bunkie and ICON.</p>
    </section>

    {email?.url && (
      <section aria-labelledby="try-product" class="flex flex-wrap items-center justify-between gap-6 rounded-2xl border border-blue-1 px-10 py-12 max-sm:px-5">
        <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-2">
          <h2 id="try-product" class="text-[28px] leading-tight">Want me to try out your product?</h2>
          <p class="leading-relaxed text-[#4a4843]">Send me an email with the details. Other questions? Email me, or wait for this page to be updated.</p>
        </div>
        <a href={`mailto:${email.url}`} class="inline-flex min-h-12 items-center gap-2.5 rounded-full bg-[#1d756a] px-5.5 text-white-1 transition hover:brightness-110">
          <Mail size={18} />
          {email.url}
        </a>
      </section>
    )}
  </main>
</Layout>
