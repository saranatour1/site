---
import CardWrapper from "../components/CardWrapper.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Services" description="Services offered by Sara Natour">
  <!-- I probably should move this into a CMS or something, should I make a chat box in here, or make email conversations? -->
  <!-- I prefer email conversations  -->
  <section
    class="flex flex-col justify-between items-center max-md:flex-col w-full max-w-200 mt-4 prose-h1:text-green-950"
  >
    <CardWrapper
      className="flex justify-between items-center w-full max-md:flex-col"
      enableWobble={false}
    >
      <h1 class="text-2xl text-black-1"> I offer online Services </h1>
    </CardWrapper>
  </section>
</Layout>
