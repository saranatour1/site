---
import CardWrapper from "../components/CardWrapper.astro";
import Layout from "../layouts/Layout.astro";
import { Card, CardTitle, CardDescription } from "../components/ui/AnimatedCard";
import { socialLinks } from "../consts";

const email = socialLinks.find((r) => r["label"]==="email");
---

<Layout title="Services" description="Services offered by Sara Natour">
  <main
    class="flex flex-col justify-between items-center max-md:flex-col w-full max-w-200 mx-auto"
  >
    <CardWrapper className="w-full" enableWobble={false}>
      <Card className="bg-transparent w-full h-full p-6">
        <div class="flex justify-between items-center mb-4">
          <CardTitle className="text-2xl text-black-1">Work with me</CardTitle>
        </div>
        <CardDescription
          class:list={[
            "prose",
            "text-sm",
            "prose-neutral",
            "leading-relaxed",
            "max-w-none",
            "space-y-4"
          ]}
        >
          <p>
            I help startups and founders design, build, and ship software —
            remotely. Frontend, backend, testing, and AI agent integration, with
            one accountable developer end to end.
          </p>

          <h3 class="text-lg font-semibold text-black-1 mt-6 mb-2">What I can build for you</h3>
          <ul class="list-disc pl-5 space-y-2">
            <li>
              <strong>Full-stack web apps</strong> — TypeScript end to end:
              <a href="https://www.convex.dev" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">Convex</a>,
              TanStack Start, Next.js / Astro, auth, data, and integrations.
            </li>
            <li>
              <strong>AI agents &amp; integrations</strong> — agents built into
              real products, not demos.
            </li>
            <li>
              <strong>MVPs for founders</strong> — a working, fundable product in
              weeks, built clean enough to grow on.
            </li>
            <li>
              <strong>Hardware-adjacent / embedded</strong> — Electrical
              Engineering background: Arduino, ESP, and microcontrollers, board
              design in Eagle and Flux, plus the code to run it.
            </li>
          </ul>

          <h3 class="text-lg font-semibold text-black-1 mt-6 mb-2">How we'll work together</h3>
          <p>
            Discovery call → a written proposal with secured scope and milestones →
            build with regular demos → launch and handoff. I work with a simple
            signed agreement, a deposit to start, and milestone-based payments —
            so scope stays clear and we're both protected.
          </p>

          <h3 class="text-lg font-semibold text-black-1 mt-6 mb-2">Currently</h3>
          <p>
            I am Building <em>Ye 业</em>, a self-hostable job-application tracker where
            you own your data and pay only for what you use, and a Convex/Astro
            platform for a design client. <strong>Open to new projects [Also open to remote full-time work projects] and
            relocation.</strong>
          </p>

          <p class="font-medium text-black-1 mt-6">
            Tell me about your project — include your goal, a rough timeline, and
            budget so I can reply with helpful information.
          </p>
          <div class="mt-2">
            <a href={`mailto:${email?.url}`} aria-label="Send me an email" class="text-blue-600 hover:underline">
              <span class="sr-only">Send an email</span>
              {email?.url}
            </a>
          </div>

          <p class="text-xs text-neutral-500 mt-8">
            Outside of work: woodworking, a beginner garden, and admiring what
            Bunkie and ICON are building.
          </p>
        </CardDescription>
      </Card>
    </CardWrapper>
  </main>
</Layout>
