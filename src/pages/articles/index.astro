---
import Layout from "../../layouts/Layout.astro";
import Rss from "../../components/Icons/Rss.astro";
import ArticleMeta from "../../components/articles/ArticleMeta.astro";
import { getArticles } from "../../lib/articles";

const articles = await getArticles();
const description = "Articles by Sara Natour on building for the web, Convex, AI agents and whatever else she's figuring out.";

// Structured data: this page is the blog, listing each article.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": new URL("/articles#blog", Astro.site),
  name: "Articles by Sara Natour",
  description,
  url: new URL("/articles", Astro.site),
  inLanguage: "en",
  author: { "@type": "Person", name: "Sara Natour", url: Astro.site },
  blogPost: articles.map(({ id, data }) => ({
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    url: new URL(`/articles/${id}`, Astro.site),
  })),
};
// Shown under the heading when set.
const intro = "Building for the web, Convex, AI agents, and whatever else I'm figuring out.";
---

<Layout title="Articles | Sara Natour" description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <main class="w-full max-w-200 mx-auto flex flex-col gap-4">
    <header class="flex flex-col gap-3 rounded-2xl border border-blue-1 px-10 py-18 max-sm:px-5 max-sm:py-12">
      <h1 class="text-7xl leading-none tracking-tight max-sm:text-5xl">Articles</h1>
      {intro && <p class="max-w-110 text-lg leading-normal text-[#4a4843]">{intro}</p>}
      <a href="/rss.xml" class="mt-3 inline-flex min-h-11 items-center gap-2 self-start rounded-full border border-blue-1 px-4.5 text-[15px] text-blue-1 hover:bg-blue-1/10">
        <Rss />
        RSS feed
      </a>
    </header>

    <section aria-labelledby="all-articles" class="flex flex-col gap-2 rounded-2xl border border-blue-1 p-10 max-sm:px-5">
      <h2 id="all-articles" class="text-2xl">All articles</h2>
      {articles.length === 0 && <p class="py-6 text-[#4a4843]">Nothing here yet.</p>}
      {
        articles.map((article) => (
          <article class="flex flex-col gap-2 border-t border-black-1/10 py-6 last:pb-0">
            <ArticleMeta article={article} class="text-sm" />
            <h3 class="text-[28px] leading-tight" transition:name={`article-title-${article.id}`}>
              <a href={`/articles/${article.id}`} class="transition-colors hover:text-blue-1">{article.data.title}</a>
            </h3>
            <p class="text-[17px] leading-normal text-[#4a4843]" transition:name={`article-description-${article.id}`}>{article.data.description}</p>
          </article>
        ))
      }
    </section>
  </main>
</Layout>
