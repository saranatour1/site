---
import { render } from "astro:content";
import { Image } from "astro:assets";
import avatar from "../../assets/avatar.jpg";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ArticleMeta from "../../components/articles/ArticleMeta.astro";
import { getArticles } from "../../lib/articles";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article, articles } }));
}

const { article, articles } = Astro.props;
const { title, description, tags } = article.data;
const { Content } = await render(article);
const more = articles.filter((other) => other.id !== article.id).slice(0, 3);
---

<ArticleLayout article={article} more={more}>
  <header class="flex flex-col gap-5 border-b border-black-1/10 pb-8">
    <span class="self-start rounded-full bg-blue-1/12 px-3 py-1 text-[13px] text-[#14564e]">{tags[0] ?? "Writing"}</span>
    {/* Same transition names as the list rows, so the title and description glide into place. */}
    <h1 class="text-[60px] leading-[1.05] tracking-tight max-sm:text-4xl" transition:name={`article-title-${article.id}`}>{title}</h1>
    <p class="text-xl leading-normal text-[#4a4843] max-sm:text-lg" transition:name={`article-description-${article.id}`}>{description}</p>
    <div class="mt-2 flex items-center gap-3">
      <Image src={avatar} alt="" width={40} height={40} densities={[1, 2]} class="size-10 rounded-full ring-1 ring-black-1/10" />
      <div class="flex flex-col gap-0.5">
        <span>Sara</span>
        <ArticleMeta article={article} class="text-sm" />
      </div>
    </div>
  </header>
  <article class="prose prose-xl prose-neutral max-w-none pt-12 max-sm:prose-lg prose-headings:font-normal prose-headings:text-black-1 prose-a:text-blue-text prose-a:underline-offset-4 prose-blockquote:border-blue-1 prose-blockquote:font-normal prose-blockquote:text-black-1 prose-pre:rounded-2xl prose-pre:bg-black-1 prose-img:mx-auto prose-img:rounded-2xl prose-figcaption:text-center prose-figcaption:text-[#6b6860]">
    <Content />
  </article>
</ArticleLayout>
