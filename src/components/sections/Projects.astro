---
import { Octokit } from "@octokit/core";
import Card from "../ui/Card.astro";
import CardTitle from "../ui/CardTitle.astro";

interface ProjectType {
  name: string;
  description?: string | null;
  url: string;
}
const query = `
  query {
    user(login: "saranatour1") {
      pinnedItems(first: 6, types: REPOSITORY) {
        nodes {
          ... on Repository {
            name
            description
            url
          }
        }
      }
    }
  }
`;

// Mirrors the pinned repos on github.com/saranatour1 (Oct 2026); shown when the build has no GITHUB_TOKEN.
const FALLBACK_PROJECTS: ProjectType[] = [
  {
    name: "ai-chat-bot-convex",
    description: "AI chat app template using convex, next.js, ai!",
    url: "https://github.com/saranatour1/ai-chat-bot-convex",
  },
  {
    name: "agent-arena",
    url: "https://github.com/saranatour1/agent-arena",
  },
  {
    name: "Email-bro",
    description: "All your Gmail inboxes in one place. An AI sorts each new email into Needs action, Goal, Info or Spam, so only what matters is on top.",
    url: "https://github.com/saranatour1/Email-bro",
  },
  {
    name: "Story-time",
    description: "Personal scrap book/Journal",
    url: "https://github.com/saranatour1/Story-time",
  },
  {
    name: "Convex-Regions",
    description: "Convex Regions, which one is closest?",
    url: "https://github.com/saranatour1/Convex-Regions",
  },
];

let pinnedItems: ProjectType[] = FALLBACK_PROJECTS;

if (import.meta.env.GITHUB_TOKEN) {
  try {
    const octokit = new Octokit({
      auth: import.meta.env.GITHUB_TOKEN,
      // @octokit/request v9 has no `timeout` option; abort via signal so a
      // hung connection can't stall the prerender
      request: { signal: AbortSignal.timeout(10_000) },
    });

    const response = await octokit.graphql(query, {
      baseUrl: "https://api.github.com",
    });

    pinnedItems = (response as any).user.pinnedItems.nodes;
  } catch (error) {
    console.warn(
      "Failed to fetch pinned repos from GitHub, using fallback list:",
      error instanceof Error ? error.message : error,
    );
  }
} else {
  console.warn("GITHUB_TOKEN is not set, using fallback project list");
}
---

<section class="mt-4 w-full max-w-200">
    <Card className="bg-transparent border-blue-1 p-8">
      <CardTitle as="h2" className="text-2xl font-bold leading-6 ">Cool things</CardTitle>
      <!-- CSS-only magnetic hover (anchor positioning); styles live in globals.css (.magnetic) -->
      <div class="magnetic grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {pinnedItems.map((item) => (
          <a href={item.url} class="magnetic-item relative block p-2 h-full w-full">
            <div class="rounded-2xl h-full w-full p-8 overflow-hidden bg-white-1 border border-blue-1 relative z-20">
              <h3 class="text-black font-bold tracking-wide mt-4">{item.name}</h3>
              {item.description && <p class="mt-8 text-zinc-600 tracking-wide text-sm">{item.description}</p>}
            </div>
          </a>
        ))}
      </div>
    </Card>
</section>
