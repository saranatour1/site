---
import CardWrapper from "../CardWrapper.astro";
import { Card, CardTitle, CardDescription } from "../ui/AnimatedCard";
---

<div class="mt-4 w-full max-w-200">
  <CardWrapper className="">
    <Card className="bg-transparent">
      <CardTitle> Professional experience </CardTitle>
      <CardDescription>
        <div class="w-full">
          <ul class="flex items-center justify-between contrast-50">
            <li>- Independent Contractor (Freelance)</li>
            <li>
              <time datetime="2024-04">April 2024</time> - Present
            </li>
          </ul>
          <p class="p-4 w-full max-w-full prose">
            Freelance full-stack development for clients and businesses,
            building web applications with React, Next.js and Convex. Open
            source contributor. Currently available for new projects.
            Working on client projects like Sirdab, Markets, which will be released this year. 
            <br />
            <span class="text-sm text-gray-900"
              >Also, If you have a business and would like to improve the SEO
              and Visibility, Email me for a quote.

              I will send out an ad soon for this.
              </span
            >
          </p>
        </div>
        <div class="w-full">
          <ul class="flex items-center justify-between contrast-50">
            <li>- Independent Study & Relocation</li>
            <li>
              <time datetime="2025-02">February 2025</time> - <time
                datetime="2025-11">November 2025</time
              >
            </li>
          </ul>
          <p class="p-4 w-full max-w-full">
            Independent study and a career break, exploring new work ventures.
          </p>
        </div>
        <div>
          <ul class="flex items-center justify-between contrast-50">
            <li>
              - Full stack developer <span class="text-blue-900"
                >@Clarity TXT inc</span
              >
            </li>
            <li>
              <time datetime="2024-11">November 2024</time> - <time
                datetime="2025-02">February 2025</time
              >
            </li>
          </ul>
          <p class="p-4">
            worked with convex.dev, TypeScript, React, Next.js, clerk, to create
            a Real time chat application.
          </p>
        </div>
        <div>
          <ul class="flex items-center justify-between contrast-50">
            <li>
              - Full stack developer
            </li>
            <li>
              <time datetime="2023-10">October 2023</time> - <time
                datetime="2024-01">January 2024</time
              >
            </li>
          </ul>
          <p class="p-4">
            Worked with TypeScript and react on creating a Website builder
          </p>
        </div>
      </CardDescription>
    </Card>
  </CardWrapper>
</div>
