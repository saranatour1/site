---
import CardWrapper from "../CardWrapper.astro";
import { skillSet } from "../../consts";
---
<div class="w-full max-w-200 mt-4">
  <CardWrapper className="py-10 flex flex-col gap-4">
    <h2 class="text-2xl">Skills</h2>
    <ul class="grid w-full grid-cols-4 gap-x-4 gap-y-1 max-md:grid-cols-2">
      {skillSet.map((item) => (
        <li>
          <a href={item.url} target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center gap-3 transition-colors hover:text-blue-1">
            <img width={24} height={24} src={item.icon} alt="" loading="lazy" class="size-6 object-contain" />
            {item.name}
          </a>
        </li>
      ))}
    </ul>
  </CardWrapper>
</div>
