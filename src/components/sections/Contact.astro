---
import CardWrapper from "../CardWrapper.astro";
import { socialLinks } from "../../consts";
---
<div class="w-full max-w-200 mt-4">
  <CardWrapper className="py-10 flex flex-col gap-3">
    <h2 class="text-2xl">Contact information</h2>
    <div class="flex flex-wrap gap-x-8 gap-y-2">
      {socialLinks.map(({ url, icon: Icon, label }) => (
        <a
          href={label === "email" ? `mailto:${url}` : url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-2.5 text-black-1 transition-colors hover:text-blue-1"
        >
          <Icon />
          {label}
        </a>
      ))}
    </div>
  </CardWrapper>
</div>
