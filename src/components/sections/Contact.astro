---
import CardWrapper from "../CardWrapper.astro";
import { Card, CardDescription, CardTitle } from "../ui/AnimatedCard";
import { socialLinks } from "../../consts";
import Github from "../Icons/Github.astro";
import Email  from "../Icons/Email.astro";
import LinkedIn from "../Icons/LinkedIn.astro";
---
<section class="w-full max-w-200 mt-4">
  <CardWrapper className="flex justify-between items-center w-full max-md:flex-col">
  <Card className="bg-transparent">
    <CardTitle> Contact information</CardTitle>
    <CardDescription>
      <div class="w-full flex flex-col gap-4 items-start">
        {socialLinks.map((link) => {
          let label, Icon;
          if(!link) return null
          if (link.includes("github")) {
            label = "Follow me on GitHub";
            Icon = <Github  />;
          } else if (link.includes("linkedin")) {
            label = "Follow me on LinkedIn";
            Icon = <LinkedIn />;
          } else if (link.includes("@")) {
            label = "Email me";
            Icon = <Email />;
          }
      
          return (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="flex  group items-center p-2 rounded-md text-gray-700 hover:text-blue-1 transition-colors hover:bg-blue-1/10 w-full"
            >
              {Icon}
              <span class="text-sm font-medium">{label}</span>
            </a>
          );
        })}
      </div>
      
    </CardDescription>
  </Card>
  </CardWrapper>
</section>