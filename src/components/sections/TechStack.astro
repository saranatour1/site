---
import CardWrapper from "../CardWrapper.astro";
import { techStack } from "../../consts";
---
<div class="w-full max-w-200 mt-4">
  <CardWrapper className="py-10 flex flex-col gap-2">
    <h2 class="text-2xl">My tech stack</h2>
    <p class="text-[15px] text-[#6b6860]">Things I use every day</p>
    <div class="mt-4 flex flex-col">
      {techStack.map(({ title, items }) => (
        <div class="grid grid-cols-[8rem_1fr] gap-x-6 gap-y-2 border-t border-black-1/10 py-4 max-sm:grid-cols-1">
          <h3 class="pt-1 text-xs uppercase tracking-[0.12em] text-[#6b6860]">{title}</h3>
          <ul class="flex flex-wrap gap-x-5.5 gap-y-2.5">
            {items.map(([name, icon, note]) => (
              <li class="flex items-center gap-2 text-[15px]">
                <img src={`/icons/stack/${icon}`} alt="" width="16" height="16" loading="lazy" class="size-4 object-contain" />
                {name}
                {note && <span class="text-[11px] uppercase tracking-wide text-blue-1">{note}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </CardWrapper>
</div>
