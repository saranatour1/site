---
import { socialLinks } from "../../consts";
import CardWrapper from "../CardWrapper.astro";
import { Card, CardTitle, CardDescription } from "../ui/AnimatedCard";
const email = socialLinks.find((r) => r["label"]==="email");
---

<div
  class="flex justify-between items-center max-md:flex-col w-full max-w-200 mt-4"
>
  <CardWrapper>
    <Card className="bg-transparent w-full h-full">
      <CardTitle className={`text-2xl`}> About Me </CardTitle>
      <CardDescription
        class:list={[
          "prose",
          "text-sm",
          "prose-neutral",
          "leading-relaxed",
          "max-w-none",
        ]}
      >
        I'm a full-stack developer specializing in TypeScript, Convex, and AI
        agents, helping startups ship better products across commerce, health,
        and B2B. I work remotely with founders and teams — from idea to
        deployed, maintainable product. <br /> Working on something interesting? →
        <a href={`mailto:${email?.url}`}>{email?.url}</a>
      </CardDescription>
    </Card>
  </CardWrapper>
</div>
