---
import { socialLinks } from "../../consts";
import CardWrapper from "../CardWrapper.astro";
import { Card, CardTitle, CardDescription } from "../ui/AnimatedCard";
const email = socialLinks.find((r) => r["label"]==="email");
---

<div
  class="flex justify-between items-center max-md:flex-col w-full max-w-200 mt-4"
>
  <CardWrapper>
    <Card className="bg-transparent w-full h-full">
      <CardTitle className={`text-2xl`}> About Me </CardTitle>
      <CardDescription
        class:list={[
          "prose",
          "text-sm",
          "prose-neutral",
          "leading-relaxed",
          "max-w-none",
        ]}
      >
        I'm a full-stack developer specializing in TypeScript and Convex,
        helping startups ship better products across commerce, health, and B2B.
        When I'm not working, I'm building garden beds or helping people furnish
        their homes with the right tech. I like traveling, new places, new
        perspectives. <br /> Working on something interesting? →
        <a href={`mailto:${email?.url}`}>{email?.url}</a>
      </CardDescription>
    </Card>
  </CardWrapper>
</div>
