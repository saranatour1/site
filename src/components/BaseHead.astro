---
import { ClientRouter } from 'astro:transitions';
import { DATABUDDY_WEBSITE_ID } from "../lib/databuddy";

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Every page has a Markdown twin (astro.config.mjs writes it; worker.ts serves it for Accept: text/markdown).
const markdownURL = new URL(`${Astro.url.pathname.replace(/\/$/, "") || "/index"}.md`, Astro.site);

// Each platform crops to a different ratio, so each gets its own image.
const { title, description, image = "/og/og-linkedin.png", type = "website" } = Astro.props;
const twitterImage = Astro.props.image ?? "/og/og-twitter.png";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="manifest" href="/site.webmanifest" />

<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link
  rel="preload"
  href="/fonts/recoleta.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Sara Natour" />
<meta name="keywords" content="Sara Natour, Software Developer, Web Development, Full-stack Development, Testing, Convex, Astro, React, AI Agents, Electronics Design" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="Sara Natour" />
<meta property="og:locale" content="en_US" />
<meta name="theme-color" content="#fcf8ef" />
<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(twitterImage, Astro.url)} />
<!-- Databuddy analytics (cookieless, no PII) -->
<script
  src="https://cdn.databuddy.cc/databuddy.js"
  is:inline
  data-client-id={DATABUDDY_WEBSITE_ID}
  async
  crossorigin="anonymous"
  ></script>
<!-- Fonts link -->

<!-- Sitemap link -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Sara Natour" href="/rss.xml" />
<link rel="alternate" type="text/markdown" href={markdownURL} />
<ClientRouter />
