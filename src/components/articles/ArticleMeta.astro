---
// The "date • N minute read • share logos" line above an article's title,
// on the article page and in the list.
import { longDate, readingMinutes, type Article } from "../../lib/articles";

interface Props {
  article: Article;
  /** Add "With audio" for narrated articles (the list; the article page has the player). */
  audioTag?: boolean;
  class?: string;
}

const { article, audioTag = false, class: className } = Astro.props;
const { pubDate, narrated, shared } = article.data;
const names = { linkedin: "LinkedIn", x: "X" };
---

<p class:list={["m-0 flex flex-wrap items-center gap-2 text-[#6b6860]", className]}>
  <time datetime={pubDate.toISOString()}>{longDate(pubDate)}</time>
  <span aria-hidden="true">•</span>
  <span>{readingMinutes(article)} minute read</span>
  {
    audioTag && narrated && (
      <>
        <span aria-hidden="true">•</span>
        <span class="inline-flex items-center gap-1 text-[#14564e]">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3" /></svg>
          With audio
        </span>
      </>
    )
  }
  {
    shared.length > 0 && (
      <>
        <span aria-hidden="true">•</span>
        <span class="inline-flex items-center gap-0.5">
          {shared.map(({ platform, url }) => (
            <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`${names[platform]} post`} class="grid size-7 place-items-center rounded-md hover:bg-black-1/5">
              {platform === "linkedin" ? (
                <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" class="text-[#0a66c2]"><path fill="currentColor" d="M4 5.719C4 4.7695 4.789 4 5.7625 4H26.2375C27.211 4 28 4.7695 28 5.719V26.281C28 27.2305 27.211 28 26.2375 28H5.7625C4.789 28 4 27.2305 4 26.281V5.719ZM11.4145 24.091V13.2535H7.813V24.091H11.4145ZM9.6145 11.773C10.87 11.773 11.6515 10.942 11.6515 9.901C11.629 8.8375 10.8715 8.029 9.6385 8.029C8.4055 8.029 7.6 8.839 7.6 9.901C7.6 10.942 8.3815 11.773 9.5905 11.773H9.6145ZM16.9765 24.091V18.0385C16.9765 17.7145 17.0005 17.3905 17.0965 17.1595C17.356 16.513 17.9485 15.8425 18.9445 15.8425C20.248 15.8425 20.7685 16.8355 20.7685 18.2935V24.091H24.37V17.875C24.37 14.545 22.594 12.997 20.224 12.997C18.313 12.997 17.4565 14.047 16.9765 14.7865V14.824H16.9525C16.9605 14.8115 16.9685 14.799 16.9765 14.7865V13.2535H13.3765C13.4215 14.2705 13.3765 24.091 13.3765 24.091H16.9765Z" /></svg>
              ) : (
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="text-black-1"><path fill="currentColor" d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.77L17.75 3Zm-1.08 16.2h1.7L7.4 4.73H5.58L16.67 19.2Z" /></svg>
              )}
            </a>
          ))}
        </span>
      </>
    )
  }
</p>
