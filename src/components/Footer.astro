---
import { socialLinks } from "../consts";
const today = new Date();
---
<footer class="py-8 px-4 text-center text-neutral-600">
	Copyright {today.getFullYear()}.
	<div class="mt-2 flex justify-center gap-4">
		<a href="/sitemap-index.xml" class="underline hover:text-black-1">Sitemap</a>
		<a href="/privacy" class="underline hover:text-black-1">Privacy</a>
	</div>
	<div class="mt-4 flex justify-center gap-4">
		{socialLinks.map(({ url, icon: Icon, label }) => (
			<a href={label === "email" ? `mailto:${url}` : url} target="_blank" rel="noopener noreferrer" class="hover:text-black-1">
				<span class="sr-only">{label}</span>
				<Icon />
			</a>
		))}
	</div>
</footer>
