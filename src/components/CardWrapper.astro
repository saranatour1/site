---
import { cn } from "../lib/utils";
interface Props {
  className?: string;
}
const { className } = Astro.props;
---

<section class="mx-auto w-full h-auto border border-blue-1 gap-y-2 items-start relative rounded-2xl overflow-hidden">
  <div class="relative h-full sm:mx-0 sm:rounded-2xl overflow-hidden">
    <div class={cn("h-full px-4 py-20 sm:px-10", className)}>
      <slot />
    </div>
  </div>
</section>
